{% comment %}
  The supported @param types of the doc tag, read from the platform's own
  liquid_doc.json. Kept out of the markdown page that renders it: the markdown
  converter runs before Liquid, so it would turn the URL below into a link and
  leave the generated table rows unconverted.
{% endcomment %}
{% assign cache_key = context.version | append: '-doc-param-types' %}
{% cache cache_key %}
{%- capture url -%}https://deidcfp1yn7c2.cloudfront.net/platform_docs/{{ context.version }}/liquid_doc.json{%- endcapture -%}
{%- assign vocabulary = url | download_file | parse_json -%}
<table>
  <thead>
    <tr><th>Type</th><th>Description</th></tr>
  </thead>
  <tbody>
    {%- for type in vocabulary.param_types %}
    <tr><td><code>{{ type.name }}</code></td><td>{{ type.description | markdown }}</td></tr>
    {%- endfor %}
  </tbody>
</table>
{% endcache %}
