{%- assign aliases = item.aliases -%}
{%- assign description = item.description -%}
{%- assign returns = item.returns | default: item.return_type -%}
{%- assign params = item.params | default: item.parameters -%}
{%- assign examples = item.examples -%}

{% if item.name != blank %}
  <h2 id="{{ item.name | slugify }}">
    {{ item.name }}
    {%- if aliases.size > 0 -%}
      <small> (aliases:
        {% for a in aliases -%}
          <a href="#{{- a -}}">{{- a -}}</a>
        {%- endfor -%})
      </small>
    {%- endif -%}
  </h2>
{% endif %}

{% if description.size > 0 %}
  <p>{{ description | join: ', ' }}</p>
{% endif %}

{%- comment -%}
  The named arguments — `t: default: 'Missing'` — are parameters with `positional: false`. They used
  to arrive nested as `p.options`, which is still the shape an older platform version publishes, and
  this page renders per `context.version`, so both are read below.

  Counted in a loop, not selected with `| where: 'positional', false`: `where` cannot match a `false`
  target, and `false` is the only value that marks a named argument.
{%- endcomment -%}
{%- assign named_options_count = 0 -%}
{%- for p in params -%}
  {%- if p.positional == false -%}{%- assign named_options_count = named_options_count | plus: 1 -%}{%- endif -%}
{%- endfor -%}

{% if params.size > 0 %}
  <h4>Params</h4>
  <ul>
    {% for p in params %}
      {% unless p.positional == false %}
        <li>
          {{ p.name }}

          ({%- for t in p.types -%}
              {{- t  -}}
            {%- endfor -%})
          {% if p.description.size > 1 %} - {{ p.description }}{% endif %}
          {% if p.default and p.options == blank  %} - default: {{ p.default }}{% endif %}
          {% if p.options.size > 0 %}
            <ul>
              {% for o in p.options %}
                <li>
                  {{ o.name }}
                  ({%- for t in o.types -%}
                      {{- t  -}}
                    {%- endfor -%})
                  {% if o.description.size > 1 %} - {{ o.description }}{% endif %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endunless %}
    {% endfor %}
  </ul>
{% endif %}

{% if named_options_count > 0 %}
  <h4>Named options</h4>
  <ul>
    {% for o in params %}
      {% if o.positional == false %}
        <li>
          {{ o.name }}
          ({%- for t in o.types -%}
              {{- t  -}}
            {%- endfor -%})
          {% if o.description.size > 1 %} - {{ o.description }}{% endif %}
        </li>
      {% endif %}
    {% endfor %}
  </ul>
{% endif %}

{%- comment -%}
  Said only when the filter says it. Absent means nobody has stated whether the list is complete,
  which is a different claim from either answer.
{%- endcomment -%}
{% if item.named_parameters_exhaustive == false %}
  <p>Keys other than these are accepted too.</p>
{% endif %}

{% if returns.size > 0 %}
  <h4 class="break-word">Returns</h4>
  <p>
    {% for r in returns %}
      <strong>
        {% for t in r.types %}
          {{ t }}{% unless forloop.last %},{% endunless %}
        {% else %}
          {% if r.type != blank %}{{ r.type }}{% endif %}
        {% endfor %}
      </strong>

      {% if r.description.size > 1 %}
      - {{ r.description }}
      {% endif %}
    {% endfor %}
  </p>
{% endif %}

{% if examples.size > 0 %}
  <h4>Examples</h4>
  {% for e in examples %}
    <pre><code class="language-liquid">
      {{ e.raw_liquid | default: e }}
    </code></pre>
  {% endfor %}
{% endif %}

