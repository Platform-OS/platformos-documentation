{% for item in data.tags %}
  <h2 id="{{ item.name | slugify }}">{{ item.name }}</h2>

  {%- assign description = item.description -%}
  {%- assign params = item.params -%}
  {%- assign examples = item.examples -%}
  {%- comment -%}
    Both spellings, exactly as `filter.liquid` reads them: `returns` is what the generator
    serializes and `return_type` is what `platformos_tags.liquid` transports it as, so this
    template renders a tag whichever of the two documents it is handed.
  {%- endcomment -%}
  {%- assign returns = item.returns | default: item.return_type -%}

  {% if description %}
    <p>{{ description | strip_html }}</p>
  {% endif %}


  {% if params.size > 0 %}
    <h4>Params</h4>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Type</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        {% for p in params %}
          <tr>
            <td>{{ p.name }}</td>
            <td>
              {% for t in p.types %}
                {{ t }}
              {% endfor %}
            </td>
            <td>{% if p.description.size > 1 %}{{ p.description | nl2br }}{% endif %}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% endif %}

  {% if returns.size > 0 %}
    <h4>Returns</h4>
    <p>
      {% for r in returns %}
        <strong>
          {% for t in r.types %}
            {{ t }}{% unless forloop.last %},{% endunless %}
          {% else %}
            {% if r.type != blank %}{{ r.type }}{% endif %}
          {% endfor %}
        </strong>

        {% if r.description.size > 1 %}
          - {{ r.description }}
        {% endif %}
      {% endfor %}
    </p>
  {% endif %}

  {% if examples.size > 0 %}
    <h4>Examples</h4>
    {% for e in examples %}
      <pre><code class="language-liquid">
        {{ e }}
      </code></pre>
    {% endfor %}
  {% endif %}

{% endfor %}
